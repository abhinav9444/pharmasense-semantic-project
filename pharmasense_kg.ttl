    pharma:geneName "SYT2"^^xsd:string ;
    pharma:specificFunction "May have a regulatory role in the membrane interactions during trafficking of synaptic vesicles at the active zone of the synapse. It binds acidic phospholipids with a specificity that requires the presence of both an acidic head group and a diacyl backbone"^^xsd:string .

pharma:Target_Q8NER1 a pharma:ProteinTarget ;
    pharma:geneName "TRPV1"^^xsd:string ;
    pharma:generalFunction "Involved in ion channel activity"^^xsd:string ;
    pharma:specificFunction "Receptor-activated non-selective calcium permeant cation channel involved in detection of noxious chemical and thermal stimuli. Seems to mediate proton influx and may be involved in intracellular acidosis in nociceptive neurons. May be involved in mediation of inflammatory pain and hyperalgesia. Sensitized by a phosphatidylinositol second messenger system activated by receptor tyrosine kinases, which involves PKC isozymes and PCL"^^xsd:string .

pharma:Target_Q8TE23 a pharma:ProteinTarget ;
    pharma:geneName "TAS1R2"^^xsd:string ;
    pharma:generalFunction "Involved in metabotropic glutamate, GABA-B-like receptor activity"^^xsd:string ;
    pharma:specificFunction "Putative taste receptor. TAS1R2/TAS1R3 recognizes diverse natural and synthetic sweeteners"^^xsd:string .

pharma:Target_Q92637 a pharma:ProteinTarget ;
    pharma:geneName "FCGR1B"^^xsd:string .

pharma:Target_Q95460 a pharma:ProteinTarget ;
    pharma:geneName "MR1"^^xsd:string ;
    pharma:generalFunction "Involved in MHC class I receptor activity"^^xsd:string ;
    pharma:specificFunction "Has antigen presentation function. Involved in the development and expansion of a small population of T cells expressing an invariant T cell receptor alpha chain called mucosal-associated invariant T cells (MAIT). MAIT cells are preferentially located in the gut lamina propria and therfore may be involed in monitoring commensal flora or serve as a distress signal. Expression and MAIT cell recognition seem to be ligand- dependent"^^xsd:string .

pharma:Target_Q969G6 a pharma:ProteinTarget ;
    pharma:geneName "RFK"^^xsd:string ;
    pharma:generalFunction "Coenzyme transport and metabolism"^^xsd:string ;
    pharma:specificFunction "Catalyzes the phosphorylation of riboflavin (vitamin B2) to form flavin-mononucleotide (FMN)"^^xsd:string .

pharma:Target_Q96A70 a pharma:ProteinTarget ;
    pharma:geneName "ADC"^^xsd:string ;
    pharma:generalFunction "Amino acid transport and metabolism"^^xsd:string ;
    pharma:specificFunction "Decarboxylates L-arginine to agmatine. Truncated splice isoforms probably lack activity"^^xsd:string .

pharma:Target_Q96GD0 a pharma:ProteinTarget ;
    pharma:geneName "PDXP"^^xsd:string ;
    pharma:generalFunction "Carbohydrate transport and metabolism"^^xsd:string ;
    pharma:specificFunction "Pyridoxal phosphate phosphatase. Has some activity towards pyridoxal 5'-phosphate (PLP), pyridoxine 5'-phosphate (PMP) and Pyridoxine 5'-phosphate (PNP), with a highest activity with PLP followed by PNP"^^xsd:string .

pharma:Target_Q96I59 a pharma:ProteinTarget ;

    pharma:specificFunction "Catalyzes the transfer of the lipoyl group from lipoyl- AMP to the specific lysine residue of the lipoate-dependent enzymes"^^xsd:string .

pharma:Target_Q9Y285 a pharma:ProteinTarget ;

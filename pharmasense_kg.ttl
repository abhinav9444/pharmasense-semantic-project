    pharma:generalFunction "Translation, ribosomal structure and biogenesis"^^xsd:string ;
    pharma:specificFunction "ATP + L-asparagine + tRNA(Asn) = AMP + diphosphate + L-asparaginyl-tRNA(Asn)"^^xsd:string .

pharma:Target_Q96LZ3 a pharma:ProteinTarget ;
    pharma:geneName "PPP3R2"^^xsd:string ;
    pharma:specificFunction "Regulatory subunit of calcineurin, a calcium-dependent, calmodulin stimulated protein phosphatase. Confers calcium sensitivity"^^xsd:string .

pharma:Target_Q96NR8 a pharma:ProteinTarget ;
    pharma:geneName "RDH12"^^xsd:string ;
    pharma:generalFunction "Lipid transport and metabolism"^^xsd:string ;
    pharma:specificFunction "Exhibits an oxidoreductive catalytic activity towards retinoids. Most efficient as an NADPH-dependent retinal reductase. Displays high activity toward 9-cis and all-trans-retinol. Also involved in the metabolism of short-chain aldehydes. No steroid dehydrogenase activity detected. Might be the key enzyme in the formation of 11-cis-retinal from 11-cis-retinol during regeneration of the cone visual pigments"^^xsd:string .

pharma:Target_Q99259 a pharma:ProteinTarget ;
    pharma:geneName "GAD1"^^xsd:string ;
    pharma:generalFunction "Amino acid transport and metabolism"^^xsd:string ;
    pharma:specificFunction "Catalyzes the production of GABA"^^xsd:string .

pharma:Target_Q99519 a pharma:ProteinTarget ;
    pharma:geneName "NEU1"^^xsd:string ;
    pharma:generalFunction "Involved in exo-alpha-sialidase activity"^^xsd:string ;
    pharma:specificFunction "Catalyzes the removal of sialic acid (N-acetylneuramic acid) moities from glycoproteins and glycolipids. To be active, it is strictly dependent on its presence in the multienzyme complex. Appears to have a preference for alpha 2-3 and alpha 2-6 sialyl linkage"^^xsd:string .

pharma:Target_Q99624 a pharma:ProteinTarget ;
    pharma:geneName "SLC38A3"^^xsd:string ;
    pharma:generalFunction "Amino acid transport and metabolism"^^xsd:string ;
    pharma:specificFunction "Sodium-dependent amino acid/proton antiporter. Mediates electrogenic cotransport of glutamine and sodium ions in exchange for protons. Also recognizes histidine, asparagine and alanine. May mediate amino acid transport in either direction under physiological conditions. May play a role in nitrogen metabolism and synaptic transmission"^^xsd:string .

pharma:Target_Q99643 a pharma:ProteinTarget ;
    pharma:geneName "SDHC"^^xsd:string ;
    pharma:generalFunction "Energy production and conversion"^^xsd:string ;
    pharma:specificFunction "Mono-heme cytochrome b. May act as a mediator of low potential couples in an electron flow through cardiac complex II. Is involved in system II of the mitochondrial electron transport chain which is responsible for transferring electrons from succinate to ubiquinone (coenzyme Q)"^^xsd:string .

pharma:Target_Q9BQB6 a pharma:ProteinTarget ;
    pharma:geneName "VKORC1"^^xsd:string ;
    pharma:generalFunction "Involved in vitamin-K-epoxide reductase (warfarin-sensitive) activity"^^xsd:string ;
    pharma:specificFunction "Involved in vitamin K metabolism. Catalytic subunit of the vitamin K epoxide reductase (VKOR) complex which reduces inactive vitamin K 2,3-epoxide to active vitamin K"^^xsd:string .

pharma:Target_Q9BVG9 a pharma:ProteinTarget ;
    pharma:geneName "PTDSS2"^^xsd:string ;
    pharma:specificFunction "Catalyzes a base-exchange reaction in which the polar head group of phosphatidylethanolamine is replaced by L-serine"^^xsd:string .

pharma:Target_Q9BW92 a pharma:ProteinTarget ;
    pharma:geneName "TARS2"^^xsd:string ;
    pharma:generalFunction "Translation, ribosomal structure and biogenesis"^^xsd:string ;
    pharma:specificFunction "ATP + L-threonine + tRNA(Thr) = AMP + diphosphate + L-threonyl-tRNA(Thr)"^^xsd:string .

pharma:Target_Q9BXA5 a pharma:ProteinTarget ;
    pharma:geneName "SUCNR1"^^xsd:string ;
    pharma:specificFunction "Receptor for succinate"^^xsd:string .

pharma:Target_Q9BYC2 a pharma:ProteinTarget ;
    pharma:geneName "OXCT2"^^xsd:string ;
    pharma:generalFunction "Lipid transport and metabolism"^^xsd:string ;
    pharma:specificFunction "Key enzyme for ketone body catabolism. Transfers the CoA moiety from succinate to acetoacetate. Formation of the enzyme-CoA intermediate proceeds via an unstable anhydride species formed between the carboxylate groups of the enzyme and substrate"^^xsd:string .

pharma:Target_Q9GZT4 a pharma:ProteinTarget ;
    pharma:geneName "SRR"^^xsd:string ;
    pharma:generalFunction "Amino acid transport and metabolism"^^xsd:string ;
    pharma:specificFunction "Catalyzes the synthesis of D-serine from L-serine"^^xsd:string .

pharma:Target_Q9GZZ6 a pharma:ProteinTarget ;
    pharma:geneName "CHRNA10"^^xsd:string ;
    pharma:generalFunction "Involved in neurotransmitter receptor activity"^^xsd:string ;
    pharma:specificFunction "Ionotropic receptor with a probable role in the modulation of auditory stimuli. Agonist binding may induce an extensive change in conformation that affects all subunits and leads to opening of an ion-conducting channel across the plasma membrane. The channel is permeable to a range of divalent cations including calcium, the influx of which may activate a potassium current which hyperpolarizes the cell membrane. In the ear, this may lead to a reduction in basilar membrane motion, altering the activity of auditory nerve fibers and reducing the range of dynamic hearing. This may protect against acoustic trauma"^^xsd:string .

pharma:Target_Q9H3S4 a pharma:ProteinTarget ;
    pharma:geneName "TPK1"^^xsd:string ;
    pharma:generalFunction "Coenzyme transport and metabolism"^^xsd:string ;
    pharma:specificFunction "Catalyzes the phosphorylation of thiamine to thiamine pyrophosphate"^^xsd:string .

pharma:Target_Q9NSE4 a pharma:ProteinTarget ;
    pharma:geneName "IARS2"^^xsd:string ;
    pharma:generalFunction "Translation, ribosomal structure and biogenesis"^^xsd:string ;
    pharma:specificFunction "ATP + L-isoleucine + tRNA(Ile) = AMP + diphosphate + L-isoleucyl-tRNA(Ile)"^^xsd:string .

pharma:Target_Q9NWM0 a pharma:ProteinTarget ;
    pharma:geneName "SMOX"^^xsd:string ;
    pharma:generalFunction "Secondary metabolites biosynthesis, transport and catabolism"^^xsd:string ;
    pharma:specificFunction "Flavoenzyme which catalyzes the oxidation of spermine to spermidine. Can also use 1-N-acetylspermine and spermidine as substrates, with different affinity depending on the isoform (isozyme) and on the experimental conditions. Plays an important role in the regulation of polyamine intracellular concentration and has the potential to act as a determinant of cellular sensitivity to the antitumor polyamine analogs. May contribute to beta-alanine production via aldehyde dehydrogenase conversion of 3-amino-propanal"^^xsd:string .

pharma:Target_Q9UBS5 a pharma:ProteinTarget ;
    pharma:geneName "GABBR1"^^xsd:string ;
    pharma:generalFunction "Involved in GABA-B receptor activity"^^xsd:string ;
    pharma:specificFunction "Isoform 1E function may be to regulate the availability of functional GABA-B-R1A/GABA-B-R2 heterodimers by competing for GABA-B-R2 dimerization. This could explain the observation that certain small molecule ligands exhibit differential affinity for central versus peripheral sites"^^xsd:string .

pharma:Target_Q9UGM6 a pharma:ProteinTarget ;
    pharma:geneName "WARS2"^^xsd:string ;
    pharma:generalFunction "Translation, ribosomal structure and biogenesis"^^xsd:string ;
    pharma:specificFunction "ATP + L-tryptophan + tRNA(Trp) = AMP + diphosphate + L-tryptophyl-tRNA(Trp)"^^xsd:string .

pharma:Target_Q9UHI5 a pharma:ProteinTarget ;
    pharma:geneName "SLC7A8"^^xsd:string ;
    pharma:generalFunction "Amino acid transport and metabolism"^^xsd:string ;
    pharma:specificFunction "Sodium-independent, high-affinity transport of large neutral amino acids. Has higher affinity for L-phenylalanine than LAT1 but lower affinity for glutamine and serine. L-alanine is transported at physiological concentrations. Plays a role in basolateral (re)absorption of neutral amino acids"^^xsd:string .

pharma:Target_Q9UJS0 a pharma:ProteinTarget ;

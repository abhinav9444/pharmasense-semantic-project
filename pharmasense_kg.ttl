pharma:Target_O00763 a pharma:ProteinTarget ;
    pharma:geneName "ACACB"^^xsd:string ;
    pharma:generalFunction "Lipid transport and metabolism"^^xsd:string ;
    pharma:specificFunction "ACC-beta may be involved in the provision of malonyl-CoA or in the regulation of fatty acid oxidation, rather than fatty acid biosynthesis. This protein carries three functions:biotin carboxyl carrier protein, biotin carboxylase, and carboxyltransferase"^^xsd:string .

pharma:Target_O14786 a pharma:ProteinTarget ;
    pharma:geneName "NRP1"^^xsd:string ;
    pharma:specificFunction "The soluble isoform 2 binds VEGF-165 and appears to inhibit its binding to cells. It may also induce apoptosis by sequestering VEGF-165. May bind as well various members of the semaphorin family. Its expression has an averse effect on blood vessel number and integrity"^^xsd:string .

pharma:Target_O14880 a pharma:ProteinTarget ;
    pharma:geneName "MGST3"^^xsd:string ;
    pharma:specificFunction "Also functions as a glutathione peroxidase"^^xsd:string .

pharma:Target_O15382 a pharma:ProteinTarget ;
    pharma:geneName "BCAT2"^^xsd:string ;
    pharma:generalFunction "Amino acid transport and metabolism"^^xsd:string ;
    pharma:specificFunction "Catalyzes the first reaction in the catabolism of the essential branched chain amino acids leucine, isoleucine, and valine. May also function as a transporter of branched chain alpha-keto acids"^^xsd:string .

pharma:Target_O15427 a pharma:ProteinTarget ;
    pharma:geneName "SLC16A3"^^xsd:string ;
    pharma:generalFunction "Carbohydrate transport and metabolism"^^xsd:string ;
    pharma:specificFunction "Proton-linked monocarboxylate transporter. Catalyzes the rapid transport across the plasma membrane of many monocarboxylates such as lactate, pyruvate, branched-chain oxo acids derived from leucine, valine and isoleucine, and the ketone bodies acetoacetate, beta-hydroxybutyrate and acetate"^^xsd:string .

pharma:Target_O15460 a pharma:ProteinTarget ;
    pharma:geneName "P4HA2"^^xsd:string ;
    pharma:specificFunction "Catalyzes the posttranslational formation of 4- hydroxyproline in -Xaa-Pro-Gly- sequences in collagens and other proteins"^^xsd:string .

pharma:Target_O43246 a pharma:ProteinTarget ;
    pharma:geneName "SLC7A4"^^xsd:string ;
    pharma:generalFunction "Amino acid transport and metabolism"^^xsd:string ;
    pharma:specificFunction "Involved in the transport of the cationic amino acids (arginine, lysine and ornithine)"^^xsd:string .

pharma:Target_O43272 a pharma:ProteinTarget ;
    pharma:geneName "PRODH"^^xsd:string ;
    pharma:generalFunction "Amino acid transport and metabolism"^^xsd:string ;
    pharma:specificFunction "Converts proline to delta-1-pyrroline-5-carboxylate"^^xsd:string .

pharma:Target_O43447 a pharma:ProteinTarget ;
    pharma:geneName "PPIH"^^xsd:string ;
    pharma:generalFunction "Posttranslational modification, protein turnover, chaperones"^^xsd:string ;
    pharma:specificFunction "PPIases accelerate the folding of proteins. It catalyzes the cis-trans isomerization of proline imidic peptide bonds in oligopeptides. Participates in pre-mRNA splicing. May play a role in the assembly of the U4/U5/U6 tri-snRNP complex. May act as a chaperone"^^xsd:string .

pharma:Target_O43766 a pharma:ProteinTarget ;
    pharma:geneName "LIAS"^^xsd:string ;
    pharma:generalFunction "Coenzyme transport and metabolism"^^xsd:string ;
    pharma:specificFunction "Synthesis of alpha-(+)-lipoic acid. It may be involved in the sulfur insertion chemistry in lipoate biosynthesis"^^xsd:string .

pharma:Target_O60427 a pharma:ProteinTarget ;
    pharma:geneName "FADS1"^^xsd:string ;
    pharma:generalFunction "Lipid transport and metabolism"^^xsd:string .

pharma:Target_O60488 a pharma:ProteinTarget ;
    pharma:geneName "ACSL4"^^xsd:string ;
    pharma:generalFunction "Lipid transport and metabolism"^^xsd:string ;
    pharma:specificFunction "Activation of long-chain fatty acids for both synthesis of cellular lipids, and degradation via beta-oxidation. Preferentially uses arachidonate and eicosapentaenoate as substrates"^^xsd:string .

pharma:Target_O60512 a pharma:ProteinTarget ;
    pharma:geneName "B4GALT3"^^xsd:string ;
    pharma:specificFunction "Responsible for the synthesis of complex-type N-linked oligosaccharides in many glycoproteins as well as the carbohydrate moieties of glycolipids"^^xsd:string .

pharma:Target_O60513 a pharma:ProteinTarget ;
    pharma:geneName "B4GALT4"^^xsd:string ;
    pharma:specificFunction "Responsible for the synthesis of complex-type N-linked oligosaccharides in many glycoproteins as well as the carbohydrate moieties of glycolipids"^^xsd:string .

pharma:Target_O60603 a pharma:ProteinTarget ;
    pharma:geneName "TLR2"^^xsd:string ;
    pharma:generalFunction "Involved in transmembrane receptor activity"^^xsd:string ;
    pharma:specificFunction "Cooperates with LY96 to mediate the innate immune response to bacterial lipoproteins and other microbial cell wall components. Acts via MyD88 and TRAF6, leading to NF-kappa-B activation, cytokine secretion and the inflammatory response. May also promote apoptosis in response to lipoproteins. Recognizes mycoplasmal macrophage-activating lipopeptide-2kD (MALP-2), soluble tuberculosis factor (STF), phenol-soluble modulin (PSM) and B.burgdorferi outer surface protein A lipoprotein (OspA-L) cooperatively with TLR6"^^xsd:string .

pharma:Target_O60701 a pharma:ProteinTarget ;
    pharma:geneName "UGDH"^^xsd:string ;
    pharma:generalFunction "Cell wall/membrane/envelope biogenesis"^^xsd:string .

pharma:Target_O60760 a pharma:ProteinTarget ;
    pharma:geneName "HPGDS"^^xsd:string ;
    pharma:generalFunction "Involved in prostaglandin-D synthase activity"^^xsd:string ;
    pharma:specificFunction "Catalyzes the conversion of PGH2 to PGD2, a prostaglandin involved in smooth muscle contraction/relaxation and a potent inhibitor of platelet aggregation"^^xsd:string .

pharma:Target_O60779 a pharma:ProteinTarget ;
    pharma:geneName "SLC19A2"^^xsd:string ;
    pharma:generalFunction "Involved in folic acid binding"^^xsd:string ;
    pharma:specificFunction "High-affinity transporter for the intake of thiamine"^^xsd:string .

pharma:Target_O60909 a pharma:ProteinTarget ;
    pharma:geneName "B4GALT2"^^xsd:string ;
    pharma:specificFunction "Responsible for the synthesis of complex-type N-linked oligosaccharides in many glycoproteins as well as the carbohydrate moieties of glycolipids. Can produce lactose"^^xsd:string .

pharma:Target_O60931 a pharma:ProteinTarget ;
    pharma:geneName "CTNS"^^xsd:string ;
    pharma:generalFunction "Involved in L-cystine transmembrane transporter activity"^^xsd:string ;
    pharma:specificFunction "Thought to transport cystine out of lysosomes"^^xsd:string .

pharma:Target_O75469 a pharma:ProteinTarget ;
    pharma:geneName "NR1I2"^^xsd:string ;
    pharma:generalFunction "Involved in transcription factor activity"^^xsd:string ;
    pharma:specificFunction "Orphan receptor; its natural ligand is probably pregnane. Binds to a response element in the CYP3A4 and ABCB1/MDR1 genes promoter. Activates its expression in response to a wide variety of endobiotics and xenobiotics"^^xsd:string .

pharma:Target_O75600 a pharma:ProteinTarget ;
    pharma:geneName "GCAT"^^xsd:string ;
    pharma:generalFunction "Coenzyme transport and metabolism"^^xsd:string .

pharma:Target_O75899 a pharma:ProteinTarget ;
    pharma:geneName "GABBR2"^^xsd:string ;
    pharma:specificFunction "Receptor for GABA. The activity of this receptor is mediated by G-proteins that inhibit adenylyl cyclase activity, stimulates phospholipase A2, activates potassium channels, inactivates voltage-dependent calcium-channels and modulates inositol phospholipids hydrolysis. Plays a critical role in the fine-tuning of inhibitory synaptic transmission. Pre-synaptic GABA-B-R inhibit neurotransmitter release by down-regulating high- voltage activated calcium channels, whereas postsynaptic GABA-B-R decrease neuronal excitability by activating a prominent inwardly rectifying potassium (Kir) conductance that underlies the late inhibitory postsynaptic potentials. Not only implicated in synaptic inhibition but also in hippocampal long-term potentiation, slow wave sleep, muscle relaxation and antinociception"^^xsd:string .


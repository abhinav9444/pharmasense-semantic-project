@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pharma: <http://example.org/pharmasense#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pharma:AnticoagulantDrug a owl:Class ;
    rdfs:label "Anticoagulant Drug" ;
    rdfs:comment "A drug classified as an anticoagulant." ;
    rdfs:subClassOf pharma:Drug ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue pharma:Anticoagulants ;
            owl:onProperty pharma:hasCategory ] .

pharma:BiotechDrug a owl:Class ;
    rdfs:label "Biotech Drug" ;
    rdfs:comment "A drug classified as a biotechnology-derived drug." ;
    rdfs:subClassOf pharma:Drug ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue pharma:BiotechType ;
            owl:onProperty pharma:hasDrugType ] .

pharma:Drug_DB00001 a pharma:Drug ;
    pharma:atcCode "B01AE02"^^xsd:string ;
    pharma:drugBankId "DB00001"^^xsd:string ;
    pharma:drugName "Lepirudin"^^xsd:string ;
    pharma:hasCategory pharma:Anticoagulants,
        pharma:Category_Antithrombotic_Agents,
        pharma:Category_Fibrinolytic_Agents ;
    pharma:hasDrugType pharma:BiotechType ;
    pharma:hasTarget pharma:Target_,
        pharma:Target_P00734 ;
    pharma:mechanismOfAction "Lepirudin forms a stable non-covalent complex with alpha-thrombin, thereby abolishing its ability to cleave fibrinogen and initiate the clotting cascade. The inhibition of thrombin prevents the blood clotting cascade."^^xsd:string ;
    pharma:participatesInPathway pharma:Pathway_SMP00278 ;
    pharma:toxicity "In case of overdose (eg, suggested by excessively high aPTT values) the risk of bleeding is increased."^^xsd:string .


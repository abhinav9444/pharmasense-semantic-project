    rdfs:label "Antineoplastic Agents"^^xsd:string .

pharma:Category_Immunomodulatory_Agents a pharma:DrugCategory ;
    rdfs:label "Immunomodulatory Agents"^^xsd:string .

pharma:Category_Micronutrient a pharma:DrugCategory ;
    rdfs:label "Micronutrient"^^xsd:string .

pharma:Category_Dietary_supplement a pharma:DrugCategory ;
    rdfs:label "Dietary supplement"^^xsd:string .

pharma:Target_ a pharma:ProteinTarget .

pharma:SmallMoleculeType a pharma:DrugType ;
    rdfs:label "Small Molecule" ;
    rdfs:comment "Classification value indicating that a drug is a small molecule." .

pharma:BiotechType a pharma:DrugType ;
    rdfs:label "Biotech" ;
    rdfs:comment "Classification value indicating that a drug is biotechnology-derived." .

pharma:DrugCategory a owl:Class ;
    rdfs:label "Drug Category" ;
    rdfs:comment "A therapeutic or pharmacological category assigned to a drug." .

pharma:Drug a owl:Class ;
    rdfs:label "Drug" ;
    rdfs:comment "A pharmaceutical or therapeutic substance represented in the DrugBank Lite dataset." .

pharma:ProteinTarget a owl:Class ;
    rdfs:label "Protein Target" ;
    rdfs:comment "A protein that is reported as a target of a drug." .

